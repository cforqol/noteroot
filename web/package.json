{
  "name": "noteroot-web",
  "version": "0.1.0",
  "description": "Frontend for noteroot",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test app.test.cjs",
    "test:unit": "node --experimental-vm-modules ../node_modules/.bin/jest --config jest.config.js --testPathPatterns=unit",
    "test:integration": "node --experimental-vm-modules ../node_modules/.bin/jest --config jest.config.js --testPathPatterns=integration",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:coverage": "node --experimental-vm-modules ../node_modules/.bin/jest --config jest.config.js --coverage"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.5.2",
    "babel-jest": "^30.5.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^25.0.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "vim-wasm": "^0.0.13"
  }
}
