{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noteroot.local/schema/frontmatter.json",
  "title": "Note frontmatter",
  "description": "Reserved keys for a noteroot note. Unknown keys are preserved verbatim.",
  "type": "object",
  "required": ["id"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{28}$",
      "description": "ULID (26 chars, Crockford base32) plus a 2-char checksum. App-owned; never written by a plugin."
    },
    "title": { "type": "string", "maxLength": 512 },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "maxLength": 512 },
      "maxItems": 32
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
      "maxItems": 64
    },
    "collections": {
      "type": "array",
      "items": { "type": "string", "maxLength": 128 },
      "maxItems": 32
    },
    "created": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" },
    "pinned": { "type": "boolean", "default": false },
    "archived": { "type": "boolean", "default": false }
  }
}
